# Copy this file to .env only for local testing. Never upload .env or real secrets to GitHub.
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/serverlab_ai
# Set a strong admin password (12+ characters) and use the same values in your hosting dashboard.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
ADMIN_NAME=ServerLab Administrator
# Optional: set true only if your PostgreSQL provider requires TLS.
DATABASE_SSL=false
# Optional generative AI integration; keep secret and only store on the server/host.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
